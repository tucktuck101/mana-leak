# Copy to .env and fill in locally. Never commit .env.

# Model provider (LiteLLM via OpenRouter)
OPENROUTER_API_KEY=

# Models (LiteLLM model IDs, e.g. openrouter/<vendor>/<model>)
# Required: answers, judge drafts, and the sufficiency fallback.
# Development default (cheapest output pricing; model choice is re-evaluated in M9).
CHAT_MODEL=openrouter/deepseek/deepseek-v4-flash
# Optional, defaults to CHAT_MODEL. Routing and screening.
# ROUTER_MODEL=
# Optional, defaults to CHAT_MODEL. Eval semantic grading.
# GRADER_MODEL=
# Required. LiteLLM embedding model ID.
EMBEDDING_MODEL=
# Required. Vector size for rule_chunk.embedding; ingestion verifies it
# against the first embedding returned and aborts on mismatch.
EMBEDDING_DIMENSIONS=

# PostgreSQL (docker compose). Passwords are local-only placeholders to be set.
POSTGRES_PASSWORD=
MANA_LEAK_DB_PASSWORD=
LANGFUSE_DB_PASSWORD=

# Application database. Inside compose, the api service overrides this to use host `postgres`.
# <password> is a placeholder for MANA_LEAK_DB_PASSWORD's value above; replace it, do not use the literal text.
DATABASE_URL=postgresql+psycopg://mana_leak:<password>@localhost:5432/mana_leak

# Langfuse (M2). Self-hosted stack; until keys are set, tracing is disabled
# and the app still answers.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Optional, defaults to http://localhost:3001 for host/CLI use; inside
# Compose the api service defaults instead to the langfuse-web container
# URL (docker-compose.yml). Self-hosted only — there is no Langfuse Cloud
# fallback, now or later; this is never set to a Cloud URL.
# LANGFUSE_HOST=
# Langfuse-side headless provisioning (M2), read by the langfuse-web/worker
# containers (not the api service) to create the org/project/keys on first
# boot without a UI click-through; set the key pair to the same values the
# api reads above.
# LANGFUSE_INIT_ORG_ID=
# LANGFUSE_INIT_PROJECT_ID=
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# LANGFUSE_INIT_PROJECT_SECRET_KEY=
# LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_NAME=
# LANGFUSE_INIT_USER_PASSWORD=

# Langfuse stack secrets (M2, Compose-only). Read by langfuse-web/worker,
# ClickHouse, Redis, and MinIO — never by the api service. Local-only
# placeholders to be set, like the PostgreSQL passwords above.
# NEXTAUTH_SECRET=
# SALT=
# ENCRYPTION_KEY must be 64 hex characters.
# ENCRYPTION_KEY=
# CLICKHOUSE_PASSWORD=
# REDIS_AUTH=
# MINIO_ROOT_PASSWORD=

# Commander Spellbook combo lookups. Optional, defaults to
# https://backend.commanderspellbook.com.
# SPELLBOOK_BASE_URL=
# Optional, defaults to `live` (live, then cache, then fixtures); `fixtures`
# forces the offline demo path.
# COMBO_SOURCE=
# Comprehensive Rules TXT URL; required for `ingest rules` without `--url`.
# RULES_SOURCE_URL=

# Judge sufficiency backend. Optional, defaults to `local`; `jev` falls back
# to `local` on failure.
# SUFFICIENCY_BACKEND=
# Required only when SUFFICIENCY_BACKEND=jev.
# JEV_URL=
# JEV_API_KEY=

# Web -> API base URL, server-side only (used by the Next.js /api proxy).
# Optional, defaults to http://localhost:8000; Compose sets http://api:8000.
# API_BASE_URL=

# Clarification-round cap. Optional, defaults to 3; the emergency minimum
# may set this to 1.
# JUDGE_MAX_CLARIFICATIONS=
# Application version identifier. Optional; set at build to a git SHA,
# else falls back to `git rev-parse HEAD`, else null.
# APP_VERSION=
# Optional, defaults to INFO.
# LOG_LEVEL=
