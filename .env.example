# Copy to .env and fill in locally. Never commit .env.

# Model provider (LiteLLM via OpenRouter)
OPENROUTER_API_KEY=

# PostgreSQL (docker compose). Passwords are local-only placeholders to be set.
POSTGRES_PASSWORD=
MANA_LEAK_DB_PASSWORD=
LANGFUSE_DB_PASSWORD=

# Application database. Inside compose, the api service overrides this to use host `postgres`.
DATABASE_URL=postgresql+psycopg://mana_leak:<password>@localhost:5432/mana_leak

# Langfuse (self-hosted stack is the next infrastructure task)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
